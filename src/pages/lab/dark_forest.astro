---
import BreadcrumbLayout from '../../layouts/BreadcrumbLayout.astro'

/** Pixel icons, drawn as grids ('#' is a pixel) and scaled up with crisp edges. */
const icon = (rows: string[]) => ({
  w: rows[0].length,
  h: rows.length,
  px: rows.flatMap((row, y) => [...row].flatMap((c, x) => (c === '#' ? [{ x, y }] : []))),
})
const speakerOn = icon(['....#.....', '...##..#..', '#####...#.', '#####.#..#', '#####.#..#', '#####...#.', '...##..#..', '....#.....'])
const speakerOff = icon(['....#.....', '...##.....', '#####.#..#', '#####..##.', '#####..##.', '#####.#..#', '...##.....', '....#.....'])
const pause = icon(['##..##', '##..##', '##..##', '##..##', '##..##', '##..##', '##..##', '##..##'])
const play = icon(['#.....', '###...', '#####.', '######', '######', '#####.', '###...', '#.....'])
---

<BreadcrumbLayout title="Dark Forest" description="A small firelit clearing with a primitive simulation." noindex>
  <div id="app">
    <div class="bar">
      <p class="hint">hover to discover the story · click the ground to drop a stick</p>
      <div class="controls">
        <div class="sound">
          <button type="button" class="control" data-toggle="sound" aria-pressed="false" aria-label="Sound" title="Sound (S)">
            {[
              ['on', speakerOn],
              ['off', speakerOff],
            ].map(([state, i]) => (
              <svg class={`icon ${state}`} viewBox={`0 0 ${i.w} ${i.h}`} width={i.w * 2} height={i.h * 2} shape-rendering="crispEdges" aria-hidden="true">
                {i.px.map((p) => (
                  <rect x={p.x} y={p.y} width="1" height="1" />
                ))}
              </svg>
            ))}
          </button>
          <input id="volume" type="range" min="0" max="1" step="0.05" value="0.7" aria-label="Volume" title="Volume" />
        </div>
        <button type="button" class="control" data-toggle="paused" aria-pressed="false" aria-label="Pause" title="Pause (space)">
          {[
            ['playing', pause],
            ['paused', play],
          ].map(([state, i]) => (
            <svg class={`icon ${state}`} viewBox={`0 0 ${i.w} ${i.h}`} width={i.w * 2} height={i.h * 2} shape-rendering="crispEdges" aria-hidden="true">
              {i.px.map((p) => (
                <rect x={p.x} y={p.y} width="1" height="1" />
              ))}
            </svg>
          ))}
        </button>
      </div>
    </div>

    <div class="stage">
      <canvas id="canvas" aria-label="A pixel-art forest clearing at night: a campfire, a resting knight, shroomfolk, a deer and a rain pool."></canvas>
    </div>

    <ol id="story" class="story" role="log" aria-live="polite" aria-label="What happens in the clearing"></ol>
  </div>
</BreadcrumbLayout>

<style>
  /* MEKZANTINE (alpha v1), a pixel font by Michael Alexander (MEK.txt), © 2026, self-hosted with
     permission. One font pixel is 45 of its 800 units, so it is pixel-perfect at 800/45 ≈ 17.78px. */
  @font-face {
    font-family: 'Mekzantine';
    src: url('/fonts/mekzantine-alpha-v1.woff2') format('woff2');
    font-display: block;
  }

  #app {
    position: relative;
    width: 100dvw;
    height: calc(100dvh - var(--breadcrumb-header-height));
    overflow: hidden;
    background: #0d0907; /* the warm ink the story is written on, behind everything */
    display: flex;
    flex-direction: column;
  }

  .stage {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #canvas {
    display: block;
    image-rendering: pixelated;
    cursor: crosshair;
    touch-action: manipulation;
  }

  /* firelit: warm ink, carved wood edges, parchment text, an ember glow */
  #app {
    --ink: #0d0907;
    --wood: #3a281b;
    --wood-lit: #7a4423;
    --parchment: #e6d3ad;
    --parchment-dim: #8f7d63;
    --ember: #f08a3c;
    --line: 24px;
  }

  /* the top bar and the story line up with the scene (--scene-w is measured from the canvas);
     where the scene fills the screen, keep a margin. Everything sits on the same warm ink. */
  .bar {
    box-sizing: border-box;
    padding-inline: max(0.9rem, calc((100% - var(--scene-w, 100%)) / 2));
  }

  .story {
    box-sizing: border-box;
    width: min(100%, var(--scene-w, 100%));
    margin-inline: auto;
    padding-inline: max(0px, calc(0.9rem - (100% - var(--scene-w, 100%)) / 2));
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    /* room above the controls, so reaching for them doesn't catch the header's logo */
    padding-block: 1.1rem 0.5rem;
    color: var(--parchment-dim);
  }

  /* MEKZANTINE at its pixel-perfect size */
  .hint,
  .story {
    font-family: 'Mekzantine', var(--font-mono);
    font-size: calc(800px / 45);
    line-height: var(--line);
    letter-spacing: 1px; /* one font pixel between letters: easier to read */
  }

  .hint {
    margin: 0;
    min-width: 0;
    /* on narrow screens the hint takes its own line and the controls sit under it, on the right */
    flex: 1 1 20rem;
  }

  /* the story log: newest at the top, older lines pushed down; the bottom two lines of the log
     fade away (a mask, so it works however the lines wrap) */
  .story {
    list-style: none;
    margin-block: 0;
    padding-block: 0.5rem 0.75rem;
    height: calc(var(--line) * 5 + 1.25rem);
    overflow: hidden;
    position: relative;
    mask-image: linear-gradient(#000 calc(100% - var(--line) * 2 - 0.75rem), transparent calc(100% - 0.75rem));
  }

  /* (the lines are added by the script, so they need :global to escape Astro's scoping) */
  .story :global(li) {
    max-height: 0;
    opacity: 0;
    color: var(--parchment);
    overflow: hidden;
    transition:
      max-height 0.6s ease,
      opacity 0.9s ease,
      color 3s ease;
  }

  .story :global(li.shown) {
    max-height: calc(var(--line) * 4);
    opacity: 1;
  }

  /* the newest line arrives bright; the older ones dim as they're pushed down */
  .story :global(li.shown:not(:first-child)) {
    color: var(--parchment-dim);
  }

  /* phones held upright: the scene takes its own height, the story fills the rest */
  @media (orientation: portrait) {
    .stage {
      flex: 0 0 calc(100dvw * 9 / 16);
    }

    .story {
      flex: 1;
      height: auto;
      min-height: calc(var(--line) * 5 + 1.25rem);
    }
  }

  .controls,
  .sound {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .controls {
    margin-left: auto;
  }

  .sound {
    gap: 0.6rem;
  }

  /* pixel buttons: a two-pixel carved edge with notched corners (no border-radius) */
  .control {
    --edge: var(--wood);
    display: grid;
    place-items: center;
    width: 38px;
    height: 32px;
    margin: 2px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: #150e0a;
    color: var(--parchment-dim);
    cursor: pointer;
    box-shadow:
      0 -2px 0 var(--edge),
      0 2px 0 var(--edge),
      -2px 0 0 var(--edge),
      2px 0 0 var(--edge),
      inset 0 2px 0 rgb(255 255 255 / 0.05),
      inset 0 -2px 0 rgb(0 0 0 / 0.45);
    transition:
      color 0.2s ease,
      box-shadow 0.2s ease,
      filter 0.3s ease;
  }

  .control:hover {
    --edge: var(--wood-lit);
    color: #ffcf8e;
    filter: drop-shadow(0 0 6px rgb(240 138 60 / 0.35));
  }

  .control:active {
    translate: 0 1px;
  }

  .control:focus-visible,
  #volume:focus-visible {
    outline: 2px dashed var(--ember);
    outline-offset: 4px;
  }

  .control[data-toggle='sound'][aria-pressed='true'] {
    --edge: #8a4b22;
    color: #f4a259;
    filter: drop-shadow(0 0 5px rgb(240 138 60 / 0.3));
  }

  .icon {
    display: none;
    fill: currentColor;
  }

  [data-toggle='sound'][aria-pressed='true'] .on,
  [data-toggle='sound'][aria-pressed='false'] .off,
  [data-toggle='paused'][aria-pressed='false'] .playing,
  [data-toggle='paused'][aria-pressed='true'] .paused {
    display: block;
  }

  /* the volume: an ember-filled groove and a small parchment block */
  #volume {
    --fill: 70%;
    appearance: none;
    width: 84px;
    height: 28px;
    margin: 0;
    background: transparent;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .sound[data-on='false'] #volume {
    opacity: 0.45;
  }

  #volume::-webkit-slider-runnable-track {
    height: 4px;
    background: linear-gradient(to right, #c8692e var(--fill), #2b1d14 var(--fill));
    box-shadow: 0 0 0 2px #150e0a;
  }

  #volume::-moz-range-track {
    height: 4px;
    background: #2b1d14;
    box-shadow: 0 0 0 2px #150e0a;
  }

  #volume::-moz-range-progress {
    height: 4px;
    background: #c8692e;
  }

  #volume::-webkit-slider-thumb {
    appearance: none;
    width: 8px;
    height: 14px;
    margin-top: -5px;
    border: 0;
    border-radius: 0;
    background: var(--parchment);
    box-shadow:
      0 -2px 0 var(--wood),
      0 2px 0 var(--wood),
      -2px 0 0 var(--wood),
      2px 0 0 var(--wood);
  }

  #volume::-moz-range-thumb {
    width: 8px;
    height: 14px;
    border: 0;
    border-radius: 0;
    background: var(--parchment);
    box-shadow:
      0 -2px 0 var(--wood),
      0 2px 0 var(--wood),
      -2px 0 0 var(--wood),
      2px 0 0 var(--wood);
  }

  #volume {
    touch-action: none;
  }

  /* fingers: bigger buttons, a longer slider and a knob that's easy to see under a fingertip
     (the whole slider is the touch target: tap or drag anywhere along it) */
  @media (pointer: coarse) {
    .bar {
      padding-top: 1.5rem;
    }

    .control {
      width: 48px;
      height: 44px;
    }

    #volume {
      width: 132px;
      height: 44px;
    }

    #volume::-webkit-slider-runnable-track {
      height: 6px;
    }

    #volume::-moz-range-track,
    #volume::-moz-range-progress {
      height: 6px;
    }

    #volume::-webkit-slider-thumb {
      width: 14px;
      height: 26px;
      margin-top: -10px;
    }

    #volume::-moz-range-thumb {
      width: 14px;
      height: 26px;
    }
  }

  #volume:hover::-webkit-slider-thumb {
    background: #ffcf8e;
  }
</style>

<script>
  import { startDarkForest, type DarkForestState } from '../../lib/dark-forest'
  import type { Relic } from '../../lib/dark-forest/world'

  const canvas = document.getElementById('canvas') as HTMLCanvasElement
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-toggle]')
  const params = new URLSearchParams(location.hash.slice(1))

  // the village's story: the newest line arrives at the top of the log and pushes the older ones
  // down, where the last two fade away; lines that arrive together queue up, each gets a moment
  const story = document.getElementById('story')!
  const storyQueue: string[] = []
  let telling = false
  function tellStory(line: string) {
    storyQueue.push(line)
    if (!telling) showNext()
  }
  function showNext() {
    const line = storyQueue.shift()
    telling = line !== undefined
    if (line === undefined) return
    // lines pushed past the bottom (through the fade) are gone
    for (const old of [...story.children] as HTMLElement[]) if (old.offsetTop >= story.clientHeight) old.remove()
    const item = document.createElement('li')
    item.textContent = line
    story.prepend(item)
    requestAnimationFrame(() => requestAnimationFrame(() => item.classList.add('shown')))
    window.setTimeout(showNext, storyQueue.length ? 1800 : 700)
  }

  const pauseButton = document.querySelector<HTMLButtonElement>('[data-toggle=paused]')!
  const soundGroup = document.querySelector<HTMLElement>('.sound')!
  const sync = (s: DarkForestState) => {
    for (const b of buttons) b.setAttribute('aria-pressed', String(s[b.dataset.toggle as keyof DarkForestState]))
    pauseButton.setAttribute('aria-label', s.paused ? 'Play' : 'Pause')
    pauseButton.title = s.paused ? 'Play (space)' : 'Pause (space)'
    soundGroup.dataset.on = String(s.sound)
  }

  // #edit on localhost: the editor's chrome goes around a smaller scene (loaded only then)
  const editing = params.has('edit') && ['localhost', '127.0.0.1'].includes(location.hostname)
  const editor = editing ? (await import('../../lib/dark-forest/editor')).mountEditor() : null
  if (editor) editor.stage.append(canvas)

  const forest = startDarkForest(canvas, {
    debug: params.has('debug'),
    rain: params.has('rain'),
    speed: Number(params.get('speed')) || 1,
    vigil: Number(params.get('vigil')) || undefined,
    relic: (params.get('relic') ?? undefined) as Relic | undefined,
    onStory: (line) => {
      tellStory(line)
      editor?.story(line)
    },
    onChange: (s) => {
      sync(s)
      editor?.refresh()
    },
    onInspect: () => editor?.refresh(),
  })
  sync(forest.state())
  // the bars line up with the scene, whatever size it fits to
  new ResizeObserver(() => document.getElementById('app')!.style.setProperty('--scene-w', `${canvas.getBoundingClientRect().width}px`)).observe(canvas)
  editor?.attach(forest)
  if (params.has('debug') || editing) Object.assign(window, { forest }) // poke at it from the console

  // the volume, remembered between visits; moving it turns the sound on
  const volume = document.getElementById('volume') as HTMLInputElement
  const showVolume = () => volume.style.setProperty('--fill', `${Number(volume.value) * 100}%`)
  // tap or drag anywhere along it (a finger needn't find the knob, and the page won't scroll)
  const fromPointer = (e: PointerEvent) => {
    const box = volume.getBoundingClientRect()
    const u = Math.min(1, Math.max(0, (e.clientX - box.left) / box.width))
    volume.value = String(Math.round(u * 20) / 20)
    volume.dispatchEvent(new Event('input'))
  }
  volume.addEventListener('pointerdown', (e) => {
    e.preventDefault()
    volume.focus({ preventScroll: true })
    volume.setPointerCapture(e.pointerId)
    fromPointer(e)
  })
  volume.addEventListener('pointermove', (e) => volume.hasPointerCapture(e.pointerId) && fromPointer(e))
  volume.value = localStorage.getItem('dark-forest:volume') ?? volume.value
  forest.setVolume(Number(volume.value))
  showVolume()
  volume.addEventListener('input', () => {
    forest.setVolume(Number(volume.value))
    localStorage.setItem('dark-forest:volume', volume.value)
    showVolume()
    if (!forest.state().sound && Number(volume.value) > 0) forest.toggleSound()
  })

  const actions: Record<string, () => void> = {
    sound: forest.toggleSound,
    paused: forest.togglePause,
    rain: forest.toggleRain,
    glow: forest.toggleGlow,
    debug: forest.toggleDebug,
    normals: forest.toggleNormals,
  }
  for (const b of buttons) {
    b.addEventListener('click', () => {
      actions[b.dataset.toggle!]()
      b.blur()
    })
  }

  // S and space for everyone; the rendering switches only when debugging or editing
  const keys: Record<string, string> = { s: 'sound', ' ': 'paused' }
  if (params.has('debug') || editing) Object.assign(keys, { r: 'rain', g: 'glow', d: 'debug', n: 'normals' })
  addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return
    const action = keys[e.key.toLowerCase()]
    if (!action) return
    e.preventDefault()
    actions[action]()
  })
</script>
