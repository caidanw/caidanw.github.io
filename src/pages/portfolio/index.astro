---
import ListHeader from '@/components/ListHeader.astro'
import BreadcrumbLayout from '@/layouts/BreadcrumbLayout.astro'

const projects = [
  {
    title: 'Stipple Studio',
    description: 'Interactive stippling tool with real-time visualization of the image processing pipeline',
    tech: 'Vanilla HTML/JS/CSS, Canvas API (no libraries)',
    url: '/portfolio/stipple_studio',
    sourceUrl: 'https://github.com/caidanw/caidanw.github.io/blob/main/src/pages/portfolio/stipple_studio.astro',
  },
  {
    title: 'Orbit Simulation',
    description: 'A web-based simulation of planetary orbits using physics principles',
    tech: 'Vanilla HTML/JS/CSS, Canvas API (no libraries)',
    url: '/portfolio/orbit_sim',
    sourceUrl: 'https://github.com/caidanw/caidanw.github.io/blob/main/src/pages/portfolio/orbit_sim.astro',
  },
  {
    title: 'ASCII Clouds',
    description: 'A dynamic ASCII art cloud generator that creates cloud patterns in real-time',
    tech: 'Vanilla HTML/JS/CSS, Canvas API (no libraries)',
    url: '/portfolio/ascii_clouds',
    sourceUrl: 'https://github.com/caidanw/caidanw.github.io/blob/main/src/pages/portfolio/ascii_clouds.astro',
  },
]
---

<BreadcrumbLayout title="Portfolio - Caidan Williams" description="Terminal Graph and a few canvas experiments">
  <main>
    <ListHeader>
      <h1>Portfolio</h1>
      <p class="subtitle">What I'm building, and a few things I built to learn.</p>
    </ListHeader>

    <section class="flagship">
      <a
        class="flagship-media"
        href="https://terminalgraph.com"
        target="_blank"
        rel="noopener"
        aria-label="Terminal Graph — open terminalgraph.com"
      >
        <img
          src="/terminal-graph-hero.svg"
          width="1348"
          height="628"
          loading="lazy"
          decoding="async"
          alt="A Terminal Graph canvas: a Trigger node wired into a Run node executing git diff --staged, feeding a Template that pipes the staged diff into a Claude Code terminal — four connected nodes on one infinite canvas."
        />
      </a>
      <div class="flagship-body">
        <h2 class="flagship-title">Terminal Graph</h2>
        <p class="flagship-desc">
          A spatial development environment for macOS. Terminals, browsers, editors, and notes on one infinite canvas,
          connected by dataflow. Instead of a dozen scattered windows, you see the whole shape of what you're working on.
        </p>
        <p class="flagship-tech"><span>Tech:</span> Swift · Metal · AppKit · libghostty</p>
        <p class="flagship-status">Free public beta · Native macOS · No account required</p>
        <a class="flagship-link list" href="https://terminalgraph.com" target="_blank" rel="noopener">terminalgraph.com</a>
      </div>
    </section>

    <h2 class="section-label">Experiments</h2>
    <div class="projects-grid">
      {
        projects.map((project) => (
          <section class="project">
            <div class="project-header">
              <a href={project.url} class="project-title list">
                {project.title}
              </a>
              <a href={project.sourceUrl} class="source-link">
                &raquo; source code &laquo;
              </a>
            </div>
            <p class="project-description">{project.description}</p>
            <p class="project-tech">
              <span>Tech:</span> {project.tech}
            </p>
          </section>
        ))
      }
    </div>
  </main>
</BreadcrumbLayout>

<style>
  /* Terminal Graph — the flagship. The one place the page spends boldness. */
  .flagship {
    margin-bottom: 2.5rem;
    border: 1px solid var(--theme-border);
    border-radius: 10px;
    overflow: hidden;
    background:
      radial-gradient(var(--theme-border) 1px, transparent 1px) 0 0 / 18px 18px,
      var(--theme-bg);
  }

  .flagship-media {
    display: block;
    background: var(--color-blacker);
    border-bottom: 1px solid var(--theme-border);
  }

  .flagship-media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .flagship-body {
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .flagship-title {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: bold;
    letter-spacing: 0.03em;
    margin-bottom: 0.5rem;
  }

  .flagship-desc {
    color: var(--theme-text-subtle);
    line-height: 1.5;
    text-wrap: pretty;
    margin-bottom: 0.75rem;
  }

  .flagship-tech {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--theme-text-dim);
    margin-bottom: 0.25rem;
  }

  .flagship-tech span {
    color: var(--theme-text-subtle);
  }

  .flagship-status {
    font-size: 0.8rem;
    color: var(--theme-text-dim);
    margin-bottom: 1rem;
  }

  .flagship-link {
    font-weight: bold;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: normal;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--theme-text-dim);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--theme-border);
  }

  .projects-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .project-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .project-title {
    display: inline-block;
    font-size: 1rem;
    font-weight: bold;
  }

  .source-link {
    font-size: 0.875rem;
    color: var(--theme-text-dim);
    text-decoration: none;

    &:hover {
      color: var(--theme-text-subtle);
      text-decoration: underline;
    }
  }

  .project-description {
    color: var(--theme-text-subtle);
    margin-bottom: 0.5rem;
    font-size: 1rem;
    text-wrap: pretty;
  }

  .project-tech {
    color: var(--theme-text-dim);
    margin-bottom: 0.5rem;
    font-size: 0.75rem;

    span {
      color: var(--theme-text-subtle);
    }
  }
</style>
