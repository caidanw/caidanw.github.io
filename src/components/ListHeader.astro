---
import Hr from '@components/Hr.astro'
---

<header>
  <slot />
</header>
<Hr />

<style>
  /* h1/p arrive via <slot />, so they don't carry this component's scope attribute. */
  header {
    > :global(h1) {
      font-size: 2rem;
      font-weight: bold;
      letter-spacing: 0.05em;

      + :global(p) {
        font-size: 1rem;
        color: var(--theme-text-dim);
        line-height: 1.35;
        /* Cancel the extra half-leading so single-line spacing matches the old line-height: 1. */
        margin-top: -0.175em;
        margin-bottom: calc(1rem - 0.175em);
      }
    }
  }
</style>
